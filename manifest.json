{"id": "kiro-auth", "name": "Kiro Auth", "version": "2.4.0", "description": "Use Kiro (AWS CodeWhisperer) Claude models in Alma via Kiro Gateway. Supports Opus 4.6, Sonnet 4.6, and all Pro models. Auto-detects models from Gateway.", "author": {"name": "Alma Community"}, "main": "main.js", "engines": {"alma": "^0.1.0"}, "type": "provider", "permissions": ["network:fetch", "network:localhost", "providers:manage", "notifications", "storage:secrets"], "activationEvents": ["onStartup"], "contributes": {"providers": [{"id": "kiro", "name": "Kiro", "authType": "api-key"}], "commands": [{"id": "kiro-auth.login", "title": "Login to Kiro"}, {"id": "kiro-auth.logout", "title": "Logout from Kiro"}, {"id": "kiro-auth.status", "title": "Kiro Connection Status"}]}, "keywords": ["kiro", "claude", "oauth", "dynamic-models", "proxy", "codewhisperer", "aws", "kiro-gateway"]}